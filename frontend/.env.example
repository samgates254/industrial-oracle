# demo | api
NEXT_PUBLIC_DATA_SOURCE=demo

# Required when NEXT_PUBLIC_DATA_SOURCE=api (ZIP backend)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001

# Frozen optimization engine (FastAPI)
NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:8000

# Display timezone for operator timestamps
NEXT_PUBLIC_OPERATOR_TZ=Africa/Nairobi
